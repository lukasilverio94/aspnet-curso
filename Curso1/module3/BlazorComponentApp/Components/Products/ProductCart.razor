<div class="card h-100 shadow-sm border-0">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img src="@ImageUrl" class="card-img-top" alt="@Title" style="height: 220px; object-fit: cover;" />
    }

    <div class="card-body d-flex flex-column">
        @if (!string.IsNullOrWhiteSpace(Category))
        {
            <span class="text-uppercase text-muted small fw-semibold">@Category</span>
        }

        <h5 class="card-title mt-2 mb-2">@Title</h5>

        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="card-text text-muted">@Description</p>
        }

        <div class="mt-auto d-flex align-items-center justify-content-between">
            <strong class="text-primary">@Price.ToString("C")</strong>
            <button class="btn btn-primary btn-sm" type="button" @onclick="OnAddToCart">
                Add to cart
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Description { get; set; } = string.Empty;

    [Parameter]
    public string Category { get; set; } = string.Empty;

    [Parameter]
    public string ImageUrl { get; set; } = string.Empty;

    [Parameter]
    public decimal Price { get; set; }

    [Parameter]
    public EventCallback OnAddToCart { get; set; }
}
