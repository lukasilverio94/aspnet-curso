@{
    ViewData["Title"] = "Preferences";
}

<h1>Preferences</h1>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

<form asp-controller="Home" asp-action="SavePreferences" method="post">
    <div class="mb-3">
        <label for="theme" class="form-label">Theme</label>
        <select id="theme" name="theme" class="form-select">
            <option value="light" selected="@(ViewBag.CurrentTheme == "light")">Light</option>
            <option value="dark" selected="@(ViewBag.CurrentTheme == "dark")">Dark</option>
        </select>
    </div>
    <div class="mb-3">
        <label for="language" class="form-label">Language</label>
        <select id="language" name="language" class="form-select">
            <option value="pt-BR" selected="@(ViewBag.CurrentLanguage == "pt-BR")">Portuguese (Brazil)</option>
            <option value="en" selected="@(ViewBag.CurrentLanguage == "en")">English</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Save preferences</button>
</form>
