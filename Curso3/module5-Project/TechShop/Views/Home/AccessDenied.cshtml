@{
    ViewData["Title"] = "Access denied";
}

<div class="text-center py-5">
    <h1 class="display-6">Access denied</h1>
    <p class="text-muted">You do not have permission to view this page.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Home</a>
    }
    else
    {
        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Log in</a>
    }
</div>
