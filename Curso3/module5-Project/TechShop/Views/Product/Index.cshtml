@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Products";
}

<h1 class="mb-4">Products</h1>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var p in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="@p.ImageUrl" class="card-img-top bg-light p-3" alt="@p.Name" style="height: 180px; object-fit: contain;" />
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">@p.Name</h2>
                    <p class="card-text text-muted small flex-grow-1">@(p.Description.Length > 120 ? p.Description[..120] + "…" : p.Description)</p>
                    <p class="fw-bold mb-2">@p.Price.ToString("C")</p>
                    <a class="btn btn-outline-primary mt-auto" asp-action="Details" asp-route-id="@p.Id">View details</a>
                </div>
            </div>
        </div>
    }
</div>
