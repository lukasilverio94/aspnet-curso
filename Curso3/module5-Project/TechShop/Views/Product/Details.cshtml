@model Product
@{
    ViewData["Title"] = Model.Name;
}

@if (TempData["CartMessage"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <div class="col-md-5">
        <img src="@Model.ImageUrl" class="img-fluid rounded border bg-light p-4 w-100" alt="@Model.Name" style="max-height: 360px; object-fit: contain;" />
    </div>
    <div class="col-md-7">
        <h1 class="display-6">@Model.Name</h1>
        <p class="text-muted mb-2">@Model.Category.Name</p>
        <p class="lead">@Model.Price.ToString("C")</p>
        <p>@Model.Description</p>
        @if (Model.IsAvailable && Model.StockQuantity > 0)
        {
            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-flex flex-wrap align-items-end gap-2 mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <div>
                    <label for="quantity" class="form-label mb-0">Quantity</label>
                    <input type="number" class="form-control" id="quantity" name="quantity" value="1" min="1" max="@Model.StockQuantity" style="width: 6rem;" />
                </div>
                <button type="submit" class="btn btn-primary">Add to cart</button>
            </form>
            <p class="small text-muted mt-2">@Model.StockQuantity in stock</p>
        }
        else
        {
            <p class="text-danger fw-semibold mt-3">Out of stock</p>
        }
        <p class="mt-3 mb-0">
            <a asp-action="Index">← Back to products</a>
        </p>
    </div>
</div>
